# Fill in the 7 values below. Everything else has a working default in
# src/quizgen/config.py — override there or add the name here only if you need to.
#
# Get a Key Vault value with:
#   az keyvault secret show --vault-name <VAULT> --name AISearchAPIKEY --query value -o tsv

# --- from Key Vault (6 secrets) ---
AISearchAPIKEY=
AISearchEnpoint=
Group7-7OpenAIAPIKey=
Group7-8OpenAIEndPoint=
Group7-8text-embedding-3-large-APIKEY=
Group7-8text-embedding-3-large-Endpoint=

# --- Azure SQL (same password as the workflow's SQL_ADMIN_PASSWORD secret) ---
SQL_PASSWORD=

# --- from the storage account, not in Key Vault ---
#   az storage account show-connection-string --name mobtrainingstorage --query connectionString -o tsv
AZURE_STORAGE_CONNECTION_STRING=


# ---------------------------------------------------------------------------
# Optional. Uncomment only if a default is wrong — `quizgen doctor` will tell you.
# ---------------------------------------------------------------------------
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# DOCUMENT_CONTAINERS=company-docs:ALL,software-engineering-docs:SWE
# QUIZGEN_PROVIDER=mock
